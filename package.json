{
  "name": "huallet",
  "private": true,
  "version": "1.3.4",
  "type": "module",
  "description": "Huallet — web wallet for Chihuahua Chain and the Cosmos ecosystem",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/third-party-notices.mjs dist && cp LICENSE NOTICE dist/",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "build:ext": "node scripts/build-extension.mjs",
    "test:e2e": "node e2e/extension.e2e.mjs && node e2e/ledger.e2e.mjs",
    "package:source": "node scripts/package-source.mjs",
    "build:mobile": "node scripts/build-mobile.mjs && npx cap sync android",
    "test:android": "node e2e/android.e2e.mjs",
    "release:android": "node scripts/release-android.mjs",
    "fdroid:repo": "node scripts/fdroid-repo.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@cosmjs/amino": "^0.39.0",
    "@cosmjs/crypto": "^0.39.0",
    "@cosmjs/encoding": "^0.39.0",
    "@cosmjs/ledger-amino": "^0.39.0",
    "@cosmjs/math": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@tanstack/react-query": "^5.103.2",
    "buffer": "^6.0.3",
    "cosmjs-types": "^0.11.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@scure/base": "2.2.0"
  },
  "license": "Apache-2.0",
  "author": "The Chihuahua Chain Project",
  "homepage": "https://github.com/ChihuahuaChain/huallet#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChihuahuaChain/huallet.git"
  },
  "bugs": {
    "url": "https://github.com/ChihuahuaChain/huallet/issues"
  }
}
